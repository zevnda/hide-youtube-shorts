{
    "name": "Hide YouTube Shorts",
    "description": "Hide YouTube Shorts videos effortlessly with this powerful browser extension",
    "version": "1.9.1",
    "manifest_version": 2,
    "browser_specific_settings": {
        "gecko": {
            "id": "{a29a1b45-9fda-47d3-bdd7-8c6a80e0a31e}",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "permissions": [
        "tabs",
        "storage",
        "*://*.youtube.com/*"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "browser_action": {
        "default_title": "Hide YouTube Shorts"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}